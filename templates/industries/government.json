{
  "$schema": "https://raw.githubusercontent.com/omzig/m365-zero-trust/main/schemas/industry-template.json",
  "industry": "Government",
  "version": "1.0.0",
  "description": "M365 configuration template for government agencies and contractors handling CUI",
  "compliance": [
    "CMMC 2.0 (Cybersecurity Maturity Model Certification)",
    "NIST SP 800-171",
    "NIST SP 800-53",
    "DFARS 252.204-7012",
    "ITAR (if applicable)",
    "FedRAMP (for cloud services)"
  ],
  "additionalControls": {
    "cuiHandling": {
      "cuiMarkingRequired": true,
      "cuiCategories": [
        "CTI (Controlled Technical Information)",
        "ITAR",
        "Export Controlled",
        "Law Enforcement Sensitive",
        "Privacy"
      ],
      "cuiBannerRequired": true,
      "cuiDisseminationControls": true,
      "dlpPolicies": [
        {
          "name": "Detect CUI Markings",
          "keywords": ["CUI", "CONTROLLED", "NOFORN", "ITAR", "Export Controlled"],
          "action": "Block"
        },
        {
          "name": "Detect Technical Data",
          "keywords": ["technical data", "engineering drawing", "specification"],
          "action": "NotifyAndAudit"
        }
      ]
    },
    "accessControl": {
      "nist800171AC": true,
      "leastPrivilege": true,
      "separationOfDuties": true,
      "accountManagement": {
        "privilegedAccountReview": "Monthly",
        "standardAccountReview": "Quarterly",
        "inactiveAccountDisable": "90 days"
      },
      "sessionControls": {
        "sessionTimeout": 30,
        "concurrentSessionLimit": 3,
        "remoteSessionEncryption": true
      },
      "mobileAccess": {
        "mdmRequired": true,
        "personalDevicesBlocked": true,
        "usbRestrictions": true
      }
    },
    "auditAndAccountability": {
      "nist800171AU": true,
      "comprehensiveLogging": true,
      "logRetentionYears": 3,
      "tamperProofLogs": true,
      "realTimeAlerts": true,
      "auditEvents": [
        "Authentication events",
        "Privilege escalation",
        "Data access",
        "Configuration changes",
        "Failed access attempts",
        "CUI access"
      ],
      "logProtection": {
        "encryptionAtRest": true,
        "accessRestricted": true,
        "backupRequired": true
      }
    },
    "configurationManagement": {
      "nist800171CM": true,
      "baselineConfiguration": true,
      "changeControlProcess": true,
      "securityImpactAnalysis": true,
      "leastFunctionality": true,
      "softwareRestrictions": {
        "whitelistApps": true,
        "unauthorizedSoftwareBlocked": true,
        "autoUpdateRequired": true
      }
    },
    "identificationAuthentication": {
      "nist800171IA": true,
      "mfaRequired": true,
      "mfaForAllAccess": true,
      "passwordRequirements": {
        "minLength": 14,
        "complexity": true,
        "history": 24,
        "maxAge": 60,
        "lockoutThreshold": 3,
        "lockoutDuration": 30
      },
      "piv_cac": {
        "supported": true,
        "required": false,
        "note": "PIV/CAC required for federal employees"
      }
    },
    "incidentResponse": {
      "nist800171IR": true,
      "incidentResponsePlan": true,
      "72HourReporting": true,
      "dcisReporting": true,
      "forensicCapability": true,
      "incidentCategories": [
        "Data breach",
        "Unauthorized access",
        "Malware infection",
        "Denial of service",
        "CUI spillage"
      ]
    },
    "mediaProtection": {
      "nist800171MP": true,
      "removableMediaRestrictions": true,
      "mediaSanitization": true,
      "physicalMediaProtection": true,
      "encryptionRequired": true
    },
    "personnelSecurity": {
      "nist800171PS": true,
      "backgroundChecks": true,
      "securityAwareness": true,
      "terminationProcedures": true,
      "accessAgreements": true
    },
    "physicalProtection": {
      "nist800171PE": true,
      "note": "Physical security controls handled outside M365"
    },
    "riskAssessment": {
      "nist800171RA": true,
      "vulnerabilityScanning": "Weekly",
      "penetrationTesting": "Annual",
      "riskAssessmentFrequency": "Annual"
    },
    "systemCommunicationsProtection": {
      "nist800171SC": true,
      "encryptionInTransit": true,
      "encryptionAtRest": true,
      "fipsCompliance": true,
      "networkSegmentation": true,
      "boundaryProtection": true
    },
    "systemIntegrity": {
      "nist800171SI": true,
      "malwareProtection": true,
      "securityAlerts": true,
      "flawRemediation": "30 days critical, 90 days others",
      "integrityMonitoring": true
    }
  },
  "sensitivityLabels": [
    {
      "name": "CUI",
      "priority": 1,
      "tooltip": "Controlled Unclassified Information",
      "color": "#FF0000",
      "contentMarking": {
        "headerText": "CUI - CONTROLLED UNCLASSIFIED INFORMATION",
        "footerText": "Handle in accordance with 32 CFR Part 2002"
      },
      "encryption": {
        "enabled": true,
        "protectionType": "Template",
        "offlineAccessDays": 7
      },
      "autoLabeling": {
        "enabled": true,
        "keywords": ["CUI", "CONTROLLED", "DFARS"]
      }
    },
    {
      "name": "CUI//SP-CTI",
      "priority": 2,
      "tooltip": "Controlled Technical Information",
      "color": "#FF4500",
      "contentMarking": {
        "headerText": "CUI//SP-CTI - CONTROLLED TECHNICAL INFORMATION"
      },
      "encryption": {
        "enabled": true,
        "protectionType": "Template",
        "offlineAccessDays": 1
      }
    },
    {
      "name": "FOUO",
      "priority": 3,
      "tooltip": "For Official Use Only (legacy marking)",
      "color": "#FFA500",
      "contentMarking": {
        "headerText": "FOR OFFICIAL USE ONLY"
      },
      "encryption": {
        "enabled": true,
        "protectionType": "Template"
      }
    },
    {
      "name": "Internal Government",
      "priority": 4,
      "tooltip": "Internal government/contractor use",
      "color": "#FFFF00",
      "encryption": {
        "enabled": false
      }
    }
  ],
  "teamsConfiguration": {
    "guestAccess": false,
    "externalAccess": false,
    "anonymousMeetings": false,
    "meetingRecording": true,
    "transcription": true,
    "lobbyBypass": "OrganizationOnly",
    "thirdPartyApps": "Blocked",
    "customApps": "AdminControlled"
  },
  "exchangeConfiguration": {
    "externalEncryption": true,
    "dlpStrict": true,
    "autoForwardingBlocked": true,
    "externalWarningBanner": true,
    "journaling": {
      "enabled": true,
      "retentionYears": 3
    }
  },
  "sharepointConfiguration": {
    "externalSharing": "Disabled",
    "guestAccess": false,
    "anonymousLinks": "Disabled"
  },
  "intunePolicies": {
    "personalDevicesBlocked": true,
    "encryptionRequired": true,
    "fipsCompliance": true,
    "screenCapture": "Blocked",
    "copyPaste": "Blocked",
    "usbStorage": "Blocked",
    "bluetooth": "Restricted"
  },
  "conditionalAccess": {
    "managedDevicesOnly": true,
    "compliantDevicesOnly": true,
    "approvedLocationsOnly": true,
    "blockLegacyAuth": true,
    "mfaAlways": true,
    "signInRiskBlock": "High",
    "userRiskBlock": "High"
  },
  "requiredLicenses": [
    "Microsoft 365 E5 or G5",
    "Microsoft 365 E5 Compliance",
    "Azure Information Protection P2",
    "Microsoft Defender for Endpoint P2"
  ],
  "cmmcLevelMapping": {
    "level1": {
      "practices": 17,
      "coverage": "Basic cyber hygiene"
    },
    "level2": {
      "practices": 110,
      "coverage": "Advanced cyber hygiene - CUI protection",
      "m365Coverage": "~80% achievable with M365 E5"
    },
    "level3": {
      "practices": 134,
      "coverage": "Expert - Additional controls beyond M365"
    }
  },
  "implementationChecklist": [
    "Enable CUI sensitivity labels with encryption",
    "Configure strict conditional access policies",
    "Disable all external sharing and guest access",
    "Enable comprehensive audit logging (3-year retention)",
    "Configure DLP for CUI detection and blocking",
    "Block personal devices and removable media",
    "Implement FIPS-compliant encryption",
    "Configure incident response alerts",
    "Document security baseline configuration",
    "Conduct initial vulnerability assessment",
    "Train users on CUI handling requirements"
  ],
  "documentationRequirements": [
    "System Security Plan (SSP)",
    "Plan of Action and Milestones (POA&M)",
    "Incident Response Plan",
    "Configuration Management Plan",
    "Continuous Monitoring Strategy"
  ]
}
