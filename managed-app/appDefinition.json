{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "omzig-m365-zero-trust",
      "version": "1.0.0"
    }
  },
  "parameters": {
    "appDefinitionName": {
      "type": "string",
      "defaultValue": "OmzigM365ZeroTrust",
      "metadata": {
        "description": "Name of the managed application definition"
      }
    },
    "lockLevel": {
      "type": "string",
      "defaultValue": "ReadOnly",
      "allowedValues": ["None", "CanNotDelete", "ReadOnly"],
      "metadata": {
        "description": "Lock level for the managed resource group"
      }
    },
    "publisherAuthorization": {
      "type": "array",
      "metadata": {
        "description": "Array of authorization objects with principalId and roleDefinitionId"
      }
    },
    "packageFileUri": {
      "type": "string",
      "metadata": {
        "description": "URI to the managed app package ZIP file"
      }
    }
  },
  "variables": {
    "location": "[resourceGroup().location]"
  },
  "resources": [
    {
      "type": "Microsoft.Solutions/applicationDefinitions",
      "apiVersion": "2021-07-01",
      "name": "[parameters('appDefinitionName')]",
      "location": "[variables('location')]",
      "properties": {
        "lockLevel": "[parameters('lockLevel')]",
        "authorizations": "[parameters('publisherAuthorization')]",
        "description": "Omzig M365 Zero Trust Deployment - Deploy secure Microsoft 365 environments with NSA-aligned Zero Trust controls and optional HIPAA compliance.",
        "displayName": "Omzig M365 Zero Trust",
        "packageFileUri": "[parameters('packageFileUri')]",
        "mainTemplate": {},
        "createUiDefinition": {}
      }
    }
  ],
  "outputs": {
    "appDefinitionResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Solutions/applicationDefinitions', parameters('appDefinitionName'))]"
    }
  }
}
